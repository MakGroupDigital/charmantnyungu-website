{
  "version": 2,
  "name": "charmantnyungu",
  "alias": ["charmantnyungu.com", "www.charmantnyungu.com"],
  "regions": ["cdg1"],
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "functions": {
    "api/course-package-file.js": {
      "includeFiles": "private/course-package/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/og-image.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/photos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/manifeste-etre-artificiel-autonome.pdf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/immersive",
      "destination": "/immersive/index.html"
    },
    {
      "source": "/immersive/",
      "destination": "/immersive/index.html"
    },
    {
      "source": "/a-propos",
      "destination": "/index.html"
    },
    {
      "source": "/expertise",
      "destination": "/index.html"
    },
    {
      "source": "/projets",
      "destination": "/index.html"
    },
    {
      "source": "/package-cours-complet",
      "destination": "/index.html"
    },
    {
      "source": "/cours",
      "destination": "/index.html"
    },
    {
      "source": "/formations",
      "destination": "/index.html"
    },
    {
      "source": "/manifeste",
      "destination": "/index.html"
    },
    {
      "source": "/manifeste/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/tribune",
      "destination": "/index.html"
    },
    {
      "source": "/mentions-legales",
      "destination": "/index.html"
    },
    {
      "source": "/galerie",
      "destination": "/index.html"
    }
  ],
  "trailingSlash": false,
  "cleanUrls": true
}
